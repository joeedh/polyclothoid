off factor;
off period;

sfac := (1.0-u)*u;
    
procedure bernstein(s, k, v);
    binomial(k, v)*s**v*(1.0 - s)**(k - v);

procedure taylorcoeff(f, n, expvar, start);
    (sub(expvar=start, df(f, expvar, n))/(factorial(n)) );

procedure chain(x, n1, limit);
    if (n1 = limit) then x
    else chain(x, n1-1, limit)*(x-(n1-limit));

sfac := (1.0-u)*u;
    
procedure binomial(n, k);
    factorial(n) / (factorial(k)*factorial(n-k));
    
procedure hik(i, k);
    if i = k then {1, 0} else 
    {binomial(2*k-i-1, k-i), -binomial(2*k-i-1, k-i-1)};
    
procedure ak(k, ef1, sf1, expvar, dfsign);
    for i := 0:k sum begin scalar p1, p2;
        %getting error from "taylorcoeff(sf1, i, expvar, 0)*p1*part(hik(i,k), 1)";
        %so split into multiple statements;
        
        p1 := taylorcoeff(sf1, i, expvar, 0);
        p1 := p1*part(hik(i,k), 1);
        
        p2 := taylorcoeff(ef1, i, expvar, 0);
        p2 := p2*part(hik(i,k), 2);

        return p1 + p2
    end;
    
procedure sps(seq, expvar, terms);
    sub(tmpvar=expvar, for i2 := 0:terms sum 
        ak(i2, sub(expvar=1.0-expvar, seq), seq, expvar, 1.0)*sub(u=tmpvar, sfac)**i2*(1.0-tmpvar) +
        ak(i2, seq, sub(expvar=1.0-expvar, seq), expvar, -1.0)*sub(u=1.0-tmpvar, sfac)**i2*tmpvar);

    
%testing code follows;

%operator ftst;
%   df(ftst(~s), ~x, 2) => ftst_dv(ftst(s), x, 2);

%testrules := {
%    df => ftst_df
%};

%f := sps(ftst(s), s, 4);
%f where testrules;

operator ftst, ftst_dv, fstart, fend;
%   ftst(0) => fstart,  ;
%   ftst(1) => fend,    ;

testrules := {
    df(ftst(~f), ~s, ~n) => ftst_dv(f, s, n),
    df(ftst(~f), ~s) => ftst_dv(f, s, 1),
    ftst(0) => fstart(0),
    ftst(1) => fend(0),
    ftst_dv(0, ~s, ~n) => fstart(~n),
    ftst_dv(1, ~s, ~n) => fend(~n)
};

sub(s=0, df(ftst(s), s, 2));

procedure test_sps_intern(n);
    begin scalar f1, reta, retb, ret;
        f1 := (sps(ftst(s), s, n) where testrules);
        %sub(s=0, df(f1, s, i));
        
        %reta := for i := 0:n collect sub(s=0, df(f1, s, i)) - fstart(i);
        retb := for i := 0:n collect sub(s=1, df(f1, s, i)) - fend(i);
        
        return retb
    end;

procedure test_sps();
    for i := 0:4 collect test_sps_intern(i);

ff := (sps(ftst(s), s, 1) where testrules);
test_sps();

%simple test;

operator ftst2, ftst2_dv, fstart2, fend2;
rules := {
    df(ftst2(~s), ~s) => ftst2_dv(s, 1),
    df(ftst2(~s), ~s, ~n) => ftst2_dv(s, n),
    df(ftst2_dv(~f, ~n), ~s, ~m) => ftst2_dv(f, n+m),
    df(ftst2_dv(~f, ~n), ~s) => ftst2_dv(f, n+1),
    ftst2_dv(0, ~n) => fstart(n),
    ftst2_dv(1, ~n) => fend(n)
};
let rules;
ftst2;
ff2 := sps(ftst2(s), s, 4);

sub(s=0, df(ff2, s, 0));
sub(s=0, df(ff2, s, 1));
sub(s=0, df(ff2, s, 2));
sub(s=0, df(ff2, s, 3));
sub(s=0, df(ff2, s, 4));

sub(s=1, df(ff2, s, 0));
sub(s=1, df(ff2, s, 1));
sub(s=1, df(ff2, s, 2));
sub(s=1, df(ff2, s, 3));
sub(s=1, df(ff2, s, 4));

%clear rules;


%clear ftst, ftst_dv, fstart, fend;

