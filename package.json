{
  "name": "polyclothoid",
  "version": "0.1.0",
  "description": "Polynomial clothoid-based spline solver optimized for brush strokes",
  "type": "module",
  "license": "MIT",
  "author": "Joseph Eagar",
  "main": "dist/polyclothoid.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/polyclothoid.js"
    }
  },
  "files": [
    "dist",
    "Readme.Md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "build:site": "node tools/build.mjs --minify && node tools/site.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node tools/test.mjs",
    "typecheck": "tsgo --noEmit",
    "types": "tsgo --emitDeclarationOnly --declaration --outDir dist/types",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\"",
    "lint": "eslint src tests tools",
    "lint:fix": "eslint src tests tools --fix",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "dependencies": {
    "nstructjs": "^0.8.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pathtx/prettier": "^3.3.0-dev",
    "@types/node": "^24.10.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@typescript/native-preview"
    ]
  }
}
